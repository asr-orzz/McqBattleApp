DATABASE_URL=""
USER_JWT_SECRET_KEY=""
PUSHER_APP_ID=""
PUSHER_KEY=""
PUSHER_SECRET=""
PUSHER_CLUSTER=""
OTP_SECRET=""
FRONTEND_URL="http://localhost:3000"

# Brevo (required on Render): use an API key (xkeysib-...), NOT an SMTP key.
# Render blocks outbound SMTP — create the key at Brevo → SMTP & API → API Keys.
# Also verify BREVO_SENDER_EMAIL as a sender in the Brevo dashboard.
BREVO_API_KEY=""
BREVO_SENDER_EMAIL=""
BREVO_SENDER_NAME="QuizForge"
# Optional local-only SMTP (blocked on Render):
# BREVO_SMTP_LOGIN=""
# BREVO_SMTP_KEY=""

# Groq (free LLM). Create an API key at https://console.groq.com
GROQ_API_KEY=""
GROQ_MODEL="openai/gpt-oss-20b"
